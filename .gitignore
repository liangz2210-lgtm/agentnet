# ── 依赖与构建产物 ────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# ── 私钥 / 身份文件（安全规则 2：绝不进仓库） ─────
# 只用「后缀」来匹配私钥文件本身。
# 切勿写成 identity / identity.* —— 那会把 src/identity/ 目录
# 与 test/unit/identity.test.ts 一并吞掉，且 git status 看上去依然很干净。
*.key
*.nsec
*.priv
*.pem

# ── 本地数据与密钥库 ──────────────────────────────
.agentnet/
agentnet-data/
data/
*.sqlite
*.sqlite3
*.db

# ── 环境变量 ─────────────────────────────────────
.env
.env.*
!.env.example

# ── 测试产生的临时物 ─────────────────────────────
test/tmp/
test/.tmp/
*.log

# ── 系统 ────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 交付原始件（内容与已入库的 SPEC.md / TASK-01-PROMPT.md 重复，本地保留） ──
files.zip

# ── WorkBuddy 项目数据（勿删，但不入库） ─────────
.workbuddy/
